# URL reachable from inside the silo-monitor container.
SILO_URL=http://silo:8080

# Unscoped Silo API key owned by an enabled admin account.
SILO_API_KEY=sa_replace_me

# Keep 127.0.0.1 when Pangolin/Newt runs on the Docker host. If Newt runs in
# another container, use a shared Docker network or bind an explicitly firewalled address.
MONITOR_BIND=127.0.0.1
MONITOR_PORT=8091

# Public/default-route interface used with compose.host-network.yaml.
HOST_NETWORK_INTERFACE=eth0